# Python
.venv/
__pycache__/
*.pyc

# Node -- installed by install.sh --with-frontend, into
# environments/frontend/js_project/. package-lock.json is still committed
# so the install is reproducible; only the installed tree itself isn't.
node_modules/

# Downloaded dataset shard for environments/code_review/env.py -- fetched
# once on first use, not part of the repo.
environments/code_review/.cache/

# Claude Code session-local state -- not part of the project. Note this is
# scoped to the specific lock file, not all of .claude/: .claude/skills/ is
# legitimate project config (this repo's own meta-skill) and should ship.
.claude/scheduled_tasks.lock

# Secrets -- never commit API keys or local env overrides.
.env
*.env
.env.*

# Generated experiment data, trajectories, trained skills, and results --
# all regenerable scratch state for whichever model last ran train_skill.py/
# evaluate_skill.py against a given environment, with no label indicating
# which model produced them. Trained skills + the results that validated
# them are published instead, per model, under skills/<env>/<model-slug>/
# (see publish_skills.py and the README's "Use existing skills") -- THAT
# directory is the real, labeled, human-readable reference, not this one.
experiments/*/data/
experiments/*/skills/
experiments/*/results/
